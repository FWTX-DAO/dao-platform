# Privy — use the DEVELOPMENT Privy app locally. The production app
# (dao.fwtx.city) only allows its own origin and must never be used here.
NEXT_PUBLIC_PRIVY_APP_ID=<your-dev-privy-app-id>
PRIVY_APP_SECRET=<your-dev-privy-app-secret>
# Session signer ID and secret are only needed for using session signers
# You can create these values in the Privy dashboard as described here https://docs.privy.io/wallets/using-wallets/signers/configure-signers
NEXT_PUBLIC_SESSION_SIGNER_ID=<your-session-signer-id>
SESSION_SIGNER_SECRET=<your-session-signer-secret>

# PostgreSQL (PlanetScale) — use a dev branch/database, not production
DATABASE_URL=<your-postgres-connection-string>

# Pinata IPFS
PINATA_JWT=<your-pinata-jwt-token>
NEXT_PUBLIC_GATEWAY_URL=<your-gateway-domain.mypinata.cloud>

# Production-only (Netlify): CSP_MODE=enforce switches the CSP from Report-Only to enforced
# CSP_MODE=

# `bun run privy:verify` reads PRODUCTION Privy + DB credentials from .env.production.local
