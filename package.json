{
  "private": true,
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": "1.4.4",
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "dev": "bun --bun next dev",
    "build": "bun --bun next build",
    "start": "bun --bun next start",
    "format": "bun --bun prettier --write \"{__tests__,components,pages,styles,src}/**/*.{ts,tsx,js,jsx}\"",
    "lint": "bun --bun eslint . && bun --bun prettier --check \"{__tests__,components,pages,styles,src}/**/*.{ts,tsx,js,jsx}\" && bun --bun tsc --noEmit",
    "audit": "bun audit",
    "test": "bun test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "dotenv -e .env.local -- tsx src/core/database/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:check": "drizzle-kit check",
    "db:preflight": "bun src/core/database/production-preflight.ts",
    "db:prune-defaults": "bun src/core/database/prune-default-users.ts",
    "db:referral-migration": "bun src/core/database/referral-migration.ts",
    "db:seed": "dotenv -e .env.local -- tsx src/core/database/seed.ts",
    "db:seed-rbac": "dotenv -e .env.local -- tsx src/core/database/seed-rbac.ts",
    "privy:verify": "dotenv -e .env.production.local -- tsx src/core/database/verify-privy-prod.ts"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@heroicons/react": "^2.2.0",
    "@privy-io/node": "^0.36.0",
    "@privy-io/react-auth": "^3.51.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@solana-program/memo": "^0.16.0",
    "@solana-program/system": "^0.16.0",
    "@solana-program/token": "^0.18.0",
    "@solana/kit": "^8.5.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-query-devtools": "^5.105.0",
    "@tanstack/react-table": "^9.3.1",
    "axios": "^1.21.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "framer-motion": "^14.7.1",
    "lucide-react": "^1.63.0",
    "next": "^16.4.3",
    "pg": "^8.23.1",
    "pinata": "^2.5.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "stripe": "^23.0.1",
    "tailwind-merge": "^3.7.0",
    "uuidv7": "^1.2.1",
    "viem": "^2.57.13"
  },
  "devDependencies": {
    "@netlify/plugin-nextjs": "^5.16.4",
    "@tailwindcss/postcss": "^4.3.3",
    "@tsconfig/next": "^2.0.6",
    "@tsconfig/node24": "^24.0.5",
    "@tsconfig/strictest": "^2.0.8",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.3",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "overrides": {
    "esbuild": "0.28.2",
    "query-string": "10.0.0",
    "uuid": "14.0.3",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "patchedDependencies": {
    "x402@0.7.3": "patches/x402@0.7.3.patch",
    "@coinbase/cdp-sdk@1.60.0": "patches/@coinbase%2Fcdp-sdk@1.60.0.patch"
  }
}
